# --- Postgres (used by docker-compose + DATABASE_URL below) ---
POSTGRES_USER=emailblast
POSTGRES_PASSWORD=emailblast
POSTGRES_DB=emailblast

# --- Prisma / app database connection ---
DATABASE_URL=postgresql://emailblast:emailblast@localhost:5432/emailblast?schema=public

# --- Redis (BullMQ job queue storage) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Mail API transport (used by apps/worker) ---
MAIL_API_URL=https://messages-apps.pandi.id/api/v1/mail
MAIL_API_TOKEN=
MAIL_API_MAILER=no-reply@pandi.id

# Base URL the worker uses to fetch campaign attachments from apps/web's
# /uploads static files. In docker-compose.prod.yml this is overridden to
# http://web:3000 (the internal service name).
APP_INTERNAL_URL=http://localhost:3000

# --- Worker tuning ---
WORKER_CONCURRENCY=5
WORKER_RATE_LIMIT_MAX=10
WORKER_RATE_LIMIT_DURATION_MS=1000
WORKER_JOB_ATTEMPTS=3
WORKER_BACKOFF_DELAY_MS=5000

# --- Next.js app ---
NEXT_PUBLIC_APP_NAME=Email Blast Dashboard

# --- Production deploy (docker-compose.prod.yml) ---
# Host port the web container is published on. DATABASE_URL/REDIS_HOST are
# overridden inside docker-compose.prod.yml to point at the "postgres"/"redis"
# service names, so the values above are only used for local (non-docker) dev.
WEB_PORT=3000
