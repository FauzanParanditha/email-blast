# --- Postgres (used by docker-compose + DATABASE_URL below) ---
POSTGRES_USER=emailblast
POSTGRES_PASSWORD=emailblast
POSTGRES_DB=emailblast

# --- Prisma / app database connection ---
DATABASE_URL=postgresql://emailblast:emailblast@localhost:5432/emailblast?schema=public

# --- Redis (BullMQ job queue storage) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Mail API transport (used by apps/worker) ---
MAIL_API_URL=https://messages-apps.pandi.id/api/v1/mail
MAIL_API_TOKEN=
MAIL_API_MAILER=no-reply@pandi.id

# --- Worker tuning ---
WORKER_CONCURRENCY=5
WORKER_RATE_LIMIT_MAX=10
WORKER_RATE_LIMIT_DURATION_MS=1000
WORKER_JOB_ATTEMPTS=3
WORKER_BACKOFF_DELAY_MS=5000

# --- Next.js app ---
NEXT_PUBLIC_APP_NAME=Email Blast Dashboard
